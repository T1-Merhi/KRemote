<Window x:Class="KRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KRemote" Height="720" Width="1080" MinHeight="580" MinWidth="920"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" Foreground="{StaticResource Ink}"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TabControl x:Name="RootTabs" Grid.Row="0" Style="{StaticResource FlatTabControl}"
                    SelectionChanged="RootTabs_SelectionChanged">

            <TabItem AutomationProperties.Name="Inbox">
                <TabItem.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Inbox" VerticalAlignment="Center"/>
                        <Border x:Name="UnreadBadge" Style="{StaticResource CountBadge}" Visibility="Collapsed">
                            <TextBlock x:Name="UnreadBadgeText" Text="0" FontSize="10" FontWeight="Bold"
                                       Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Margin="4,0"/>
                        </Border>
                    </StackPanel>
                </TabItem.Header>

                <Border Background="{StaticResource Card}" CornerRadius="10" Margin="0,12,0,0"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" MinWidth="200"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*" MinWidth="260"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Inbox" Style="{StaticResource Title}"/>
                            <TextBlock x:Name="InboxStatus" Style="{StaticResource Subtle}" Margin="0,3,0,0"
                                       Text="Nothing received yet."/>
                        </StackPanel>

                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                            <ListBox x:Name="InboxList" Style="{StaticResource FlatList}"
                                     ItemTemplate="{StaticResource InboxRowTemplate}"
                                     SelectionChanged="InboxList_SelectionChanged"/>
                            <StackPanel x:Name="InboxEmptyState" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="&#xE8BD;" Style="{StaticResource EmptyStateGlyph}"/>
                                <TextBlock Style="{StaticResource EmptyStateText}"
                                           Text="Nothing here yet. Anything another PC sends you lands in this list."/>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="OpenButton" Style="{StaticResource IconButton}" Content="Open" Tag="&#xE8E5;"
                                    ToolTip="Open the received file" Margin="0,0,8,6" IsEnabled="False" Click="OpenButton_Click"/>
                            <Button x:Name="ShowInFolderButton" Style="{StaticResource IconButton}" Content="Show in folder" Tag="&#xED43;"
                                    ToolTip="Reveal the file in File Explorer" Margin="0,0,8,6" IsEnabled="False" Click="ShowInFolderButton_Click"/>
                            <Button x:Name="CopyButton" Style="{StaticResource IconButton}" Content="Copy" Tag="&#xE8C8;"
                                    ToolTip="Copy the text, or a file's path" Margin="0,0,8,6" IsEnabled="False" Click="CopyButton_Click"/>
                            <Button x:Name="SaveButton" Style="{StaticResource IconButton}" Content="Save" Tag="&#xE718;"
                                    ToolTip="Keep this message after KRemote closes" Margin="0,0,8,6" IsEnabled="False" Click="SaveButton_Click"/>
                            <Button x:Name="DeleteButton" Style="{StaticResource IconButton}" Content="Delete" Tag="&#xE74D;"
                                    ToolTip="Remove this row. The downloaded file stays on disk."
                                    Margin="0,0,0,6" IsEnabled="False" Foreground="{StaticResource Danger}"
                                    Click="DeleteButton_Click"/>
                        </WrapPanel>

                        <Border Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" CornerRadius="8"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FCFCFD">
                            <Grid>
                                <TextBox x:Name="MessageView" BorderThickness="0" Background="Transparent"
                                         Padding="10" FontSize="13.5" FontFamily="Consolas, Segoe UI"
                                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                                <TextBlock x:Name="MessagePlaceholder" Style="{StaticResource EmptyStateText}"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Text="Select a message to read it."/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Saved">
                <Border Background="{StaticResource Card}" CornerRadius="10" Margin="0,12,0,0"
                        BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" MinWidth="200"/>
                            <ColumnDefinition Width="14"/>
                            <ColumnDefinition Width="*" MinWidth="260"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Row="0" Grid.Column="0">
                            <TextBlock Text="Saved" Style="{StaticResource Title}"/>
                            <TextBlock x:Name="SavedStatus" Style="{StaticResource Subtle}" Margin="0,3,0,0"
                                       Text="Nothing saved yet."/>
                        </StackPanel>

                        <Grid Grid.Row="1" Grid.Column="0" Margin="0,10,0,0">
                            <ListBox x:Name="SavedList" Style="{StaticResource FlatList}"
                                     ItemTemplate="{StaticResource InboxRowTemplate}"
                                     SelectionChanged="SavedList_SelectionChanged"/>
                            <StackPanel x:Name="SavedEmptyState" VerticalAlignment="Center" IsHitTestVisible="False">
                                <TextBlock Text="&#xE718;" Style="{StaticResource EmptyStateGlyph}"/>
                                <TextBlock Style="{StaticResource EmptyStateText}"
                                           Text="Press Save on an inbox message to keep it here after KRemote closes."/>
                            </StackPanel>
                        </Grid>

                        <WrapPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                            <Button x:Name="SavedOpenButton" Style="{StaticResource IconButton}" Content="Open" Tag="&#xE8E5;"
                                    ToolTip="Open the received file" Margin="0,0,8,6" IsEnabled="False" Click="OpenButton_Click"/>
                            <Button x:Name="SavedShowInFolderButton" Style="{StaticResource IconButton}" Content="Show in folder" Tag="&#xED43;"
                                    ToolTip="Reveal the file in File Explorer" Margin="0,0,8,6" IsEnabled="False" Click="ShowInFolderButton_Click"/>
                            <Button x:Name="SavedCopyButton" Style="{StaticResource IconButton}" Content="Copy" Tag="&#xE8C8;"
                                    ToolTip="Copy the text, or a file's path" Margin="0,0,8,6" IsEnabled="False" Click="CopyButton_Click"/>
                            <Button x:Name="UnsaveButton" Style="{StaticResource IconButton}" Content="Unsave" Tag="&#xE77A;"
                                    ToolTip="Stop keeping this message after KRemote closes"
                                    Margin="0,0,8,6" IsEnabled="False" Click="UnsaveButton_Click"/>
                            <Button x:Name="SavedDeleteButton" Style="{StaticResource IconButton}" Content="Delete" Tag="&#xE74D;"
                                    ToolTip="Remove this row. The downloaded file stays on disk."
                                    Margin="0,0,0,6" IsEnabled="False" Foreground="{StaticResource Danger}"
                                    Click="DeleteButton_Click"/>
                        </WrapPanel>

                        <Border Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" CornerRadius="8"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FCFCFD">
                            <Grid>
                                <TextBox x:Name="SavedMessageView" BorderThickness="0" Background="Transparent"
                                         Padding="10" FontSize="13.5" FontFamily="Consolas, Segoe UI"
                                         IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                                <TextBlock x:Name="SavedMessagePlaceholder" Style="{StaticResource EmptyStateText}"
                                           VerticalAlignment="Center" IsHitTestVisible="False"
                                           Text="Select a message to read it."/>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </TabItem>

            <TabItem Header="Settings">
                <ScrollViewer Margin="0,12,0,0" VerticalScrollBarVisibility="Auto">
                    <StackPanel MaxWidth="620" HorizontalAlignment="Left">

                        <Border Background="{StaticResource Card}" CornerRadius="10"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="General" Style="{StaticResource Title}"/>

                                <TextBlock Text="Display name" Style="{StaticResource Subtle}" Margin="0,14,0,4"/>
                                <Border CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FCFCFD">
                                    <TextBox x:Name="DisplayNameBox" BorderThickness="0" Background="Transparent"
                                             Padding="10,8" FontSize="13" MaxLength="60"
                                             TextChanged="DisplayNameBox_TextChanged"/>
                                </Border>
                                <TextBlock Style="{StaticResource Subtle}" Margin="0,4,0,0"
                                           Text="Shown to other PCs alongside this machine's Windows name. Leave empty to show only the Windows name."/>

                                <TextBlock Text="Downloads folder" Style="{StaticResource Subtle}" Margin="0,16,0,4"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="10"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Border Grid.Column="0" CornerRadius="8" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" Background="#FCFCFD">
                                        <TextBox x:Name="DownloadsFolderBox" BorderThickness="0" Background="Transparent"
                                                 Padding="10,8" FontSize="13" IsReadOnly="True"/>
                                    </Border>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Content="Browse…" Tag="&#xE838;"
                                            Click="BrowseDownloadsFolderButton_Click"/>
                                </Grid>
                                <Button Style="{StaticResource IconButton}" Content="Reset to default" Tag="&#xE7A7;"
                                        HorizontalAlignment="Left" Margin="0,8,0,0"
                                        Click="ResetDownloadsFolderButton_Click"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Card}" CornerRadius="10"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Sending" Style="{StaticResource Title}"/>

                                <TextBlock Text="When sending more than one file" Style="{StaticResource Subtle}" Margin="0,14,0,6"/>
                                <RadioButton x:Name="ZipModeRadio" GroupName="MultiFileMode" Content="Zip them into one archive"
                                             Checked="MultiFileMode_Changed" Margin="0,0,0,6"/>
                                <RadioButton x:Name="GroupedModeRadio" GroupName="MultiFileMode" Content="Send as separate files, grouped into one message"
                                             Checked="MultiFileMode_Changed"/>

                                <TextBlock Text="Group timeout (seconds)" Style="{StaticResource Subtle}" Margin="0,16,0,4"/>
                                <Border CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                        Background="#FCFCFD" HorizontalAlignment="Left" Width="100">
                                    <TextBox x:Name="GroupTimeoutBox" BorderThickness="0" Background="Transparent"
                                             Padding="10,8" FontSize="13" MaxLength="4"
                                             TextChanged="GroupTimeoutBox_TextChanged"/>
                                </Border>
                                <TextBlock x:Name="GroupTimeoutHint" Style="{StaticResource Subtle}" Margin="0,4,0,0"
                                           Text="If a grouped send is interrupted, whatever files did arrive are shown after this many seconds of silence."/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Card}" CornerRadius="10"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Notifications" Style="{StaticResource Title}"/>
                                <CheckBox x:Name="NotifyToastCheck" Content="Show a Windows notification"
                                          Margin="0,14,0,8" Checked="NotificationSetting_Changed" Unchecked="NotificationSetting_Changed"/>
                                <CheckBox x:Name="NotifySoundCheck" Content="Play a sound"
                                          Margin="0,0,0,8" Checked="NotificationSetting_Changed" Unchecked="NotificationSetting_Changed"/>
                                <CheckBox x:Name="NotifyFlashCheck" Content="Flash the taskbar icon"
                                          Margin="0,0,0,8" Checked="NotificationSetting_Changed" Unchecked="NotificationSetting_Changed"/>
                                <CheckBox x:Name="NotifyBadgeCheck" Content="Show an unread count on the Inbox tab"
                                          Checked="NotificationSetting_Changed" Unchecked="NotificationSetting_Changed"/>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Card}" CornerRadius="10"
                                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="16" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Security" Style="{StaticResource Title}"/>
                                <CheckBox x:Name="PinEnabledCheck" Content="Require a PIN before anyone can send me anything"
                                          Margin="0,14,0,10" Checked="PinSetting_Changed" Unchecked="PinSetting_Changed"/>

                                <StackPanel x:Name="PinOptionsPanel">
                                    <RadioButton x:Name="PinPermanentRadio" GroupName="PinMode" Content="Same PIN every time"
                                                 Checked="PinSetting_Changed" Margin="0,0,0,6"/>
                                    <RadioButton x:Name="PinRandomRadio" GroupName="PinMode" Content="New random PIN each launch"
                                                 Checked="PinSetting_Changed" Margin="0,0,0,10"/>

                                    <TextBlock x:Name="PinLabel" Text="PIN" Style="{StaticResource Subtle}" Margin="0,0,0,4"/>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Border Grid.Column="0" CornerRadius="8" BorderBrush="{StaticResource Line}"
                                                BorderThickness="1" Background="#FCFCFD" Width="120">
                                            <TextBox x:Name="PinBox" BorderThickness="0" Background="Transparent"
                                                     Padding="10,8" FontSize="15" FontFamily="Consolas" MaxLength="4"
                                                     TextChanged="PinBox_TextChanged"/>
                                        </Border>
                                        <Button Grid.Column="2" x:Name="CopyPinButton" Style="{StaticResource IconButton}"
                                                Content="Copy" Tag="&#xE8C8;" ToolTip="Copy this PIN to share it with a sender"
                                                Click="CopyPinButton_Click"/>
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <Button x:Name="ShareButton" Grid.Row="1" Style="{StaticResource IconPrimaryButton}"
                Content="Share" Tag="&#xE72D;"
                ToolTip="Send text or files to another PC (Ctrl+N)"
                HorizontalAlignment="Right" MinWidth="130" Padding="20,11"
                Margin="0,12,0,0"
                Click="ShareButton_Click"/>

    </Grid>
</Window>
