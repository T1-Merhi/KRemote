<Window x:Class="KRemote.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KRemote" Height="720" Width="1080" MinHeight="580" MinWidth="920"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI" Foreground="{StaticResource Ink}">

    <Grid Margin="14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="300" MinWidth="240"/>
            <ColumnDefinition Width="14"/>
            <ColumnDefinition Width="*" MinWidth="460"/>
        </Grid.ColumnDefinitions>

        <!-- ============ Devices on the network ============ -->
        <Border Grid.Column="0" Background="{StaticResource Card}" CornerRadius="10"
                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0">
                    <TextBlock Text="Devices" Style="{StaticResource Title}"/>
                    <TextBlock Style="{StaticResource Subtle}" Margin="0,3,0,0"
                               Text="Scan the local network for other open KRemote apps."/>
                </StackPanel>

                <Button x:Name="ScanButton" Grid.Row="1" Style="{StaticResource PrimaryButton}"
                        Content="Scan network" Margin="0,12,0,0" Click="ScanButton_Click"/>

                <StackPanel Grid.Row="2" Margin="0,10,0,0">
                    <ProgressBar x:Name="ScanProgress" Height="4" Minimum="0" Maximum="100"
                                 Visibility="Collapsed" Foreground="{StaticResource Accent}"
                                 Background="#EDEFF2" BorderThickness="0"/>
                    <TextBlock x:Name="ScanStatus" Style="{StaticResource Subtle}" Margin="0,8,0,0"
                               Text="No scan yet."/>
                </StackPanel>

                <ListBox x:Name="PeerList" Grid.Row="3" Style="{StaticResource FlatList}"
                         Margin="0,10,0,0" SelectionChanged="PeerList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding MachineName}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Address}" FontSize="11"
                                           Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <Border Grid.Row="4" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                        Padding="0,10,0,0" Margin="0,6,0,0">
                    <TextBlock x:Name="SelfStatus" Style="{StaticResource Subtle}"/>
                </Border>
            </Grid>
        </Border>

        <!-- ============ Compose + inbox ============ -->
        <Grid Grid.Column="2">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="230"/>
                <RowDefinition Height="14"/>
                <RowDefinition Height="1.25*" MinHeight="200"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="{StaticResource Card}" CornerRadius="10"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Send" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="TargetLabel" Style="{StaticResource Subtle}" Margin="0,3,0,0"
                                   Text="No device selected."/>
                    </StackPanel>

                    <!-- Optional title, shown as the bold line in the receiver's inbox. -->
                    <Border Grid.Row="1" Margin="0,12,0,0" CornerRadius="8"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FCFCFD">
                        <Grid>
                            <TextBox x:Name="TitleBox" BorderThickness="0" Background="Transparent"
                                     Padding="10,8" FontSize="13" MaxLength="120"
                                     TextChanged="TitleBox_TextChanged"/>
                            <TextBlock x:Name="TitlePlaceholder" Text="Title (optional)"
                                       IsHitTestVisible="False" Margin="11,0,0,0"
                                       VerticalAlignment="Center" FontSize="13"
                                       Foreground="{StaticResource Muted}"/>
                        </Grid>
                    </Border>

                    <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="8"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FCFCFD">
                        <TextBox x:Name="Editor" BorderThickness="0" Background="Transparent"
                                 Padding="10" FontSize="13.5" FontFamily="Consolas, Segoe UI"
                                 AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False"
                                 PreviewKeyDown="Editor_PreviewKeyDown"/>
                    </Border>

                    <StackPanel x:Name="TransferPanel" Grid.Row="3" Margin="0,12,0,0" Visibility="Collapsed">
                        <ProgressBar x:Name="TransferProgress" Height="4" Minimum="0" Maximum="100"
                                     Foreground="{StaticResource Accent}" Background="#EDEFF2"
                                     BorderThickness="0"/>
                        <TextBlock x:Name="TransferStatus" Style="{StaticResource Subtle}" Margin="0,6,0,0"/>
                    </StackPanel>

                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <TextBlock x:Name="SendStatus" Style="{StaticResource Subtle}"
                                   VerticalAlignment="Center" HorizontalAlignment="Left"
                                   TextTrimming="CharacterEllipsis" Margin="0,0,12,0"
                                   Text="Pick a device, then send text (Ctrl+Enter) or a file."/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button x:Name="SendFileButton" Style="{StaticResource GhostButton}"
                                    Content="Send file…" Click="SendFileButton_Click"/>
                            <Button x:Name="SubmitButton" Style="{StaticResource PrimaryButton}"
                                    Content="Submit" Margin="8,0,0,0" MinWidth="110"
                                    Click="SubmitButton_Click"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <GridSplitter Grid.Row="1" Height="14" HorizontalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"/>

            <Border Grid.Row="2" Background="{StaticResource Card}" CornerRadius="10"
                    BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="14">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" MinWidth="200"/>
                        <ColumnDefinition Width="14"/>
                        <ColumnDefinition Width="*" MinWidth="260"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Row="0" Grid.Column="0">
                        <TextBlock Text="Inbox" Style="{StaticResource Title}"/>
                        <TextBlock x:Name="InboxStatus" Style="{StaticResource Subtle}" Margin="0,3,0,0"
                                   Text="Nothing received yet."/>
                    </StackPanel>

                    <ListBox x:Name="InboxList" Grid.Row="1" Grid.Column="0" Style="{StaticResource FlatList}"
                             Margin="0,10,0,0" SelectionChanged="InboxList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding Header}" FontSize="12.5" FontWeight="SemiBold"
                                               Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Meta}" FontSize="11" Margin="0,2,0,0"
                                               Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <WrapPanel Grid.Row="0" Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Top">
                        <Button x:Name="OpenButton" Style="{StaticResource GhostButton}" Content="Open"
                                Margin="0,0,8,6" IsEnabled="False" Click="OpenButton_Click"/>
                        <Button x:Name="ShowInFolderButton" Style="{StaticResource GhostButton}" Content="Show in folder"
                                Margin="0,0,8,6" IsEnabled="False" Click="ShowInFolderButton_Click"/>
                        <Button x:Name="CopyButton" Style="{StaticResource GhostButton}" Content="Copy"
                                Margin="0,0,8,6" IsEnabled="False" Click="CopyButton_Click"/>
                        <Button x:Name="SaveButton" Style="{StaticResource GhostButton}" Content="Save"
                                Margin="0,0,8,6" IsEnabled="False" Click="SaveButton_Click"/>
                        <Button x:Name="DeleteButton" Style="{StaticResource GhostButton}" Content="Delete"
                                Margin="0,0,0,6" IsEnabled="False" Foreground="{StaticResource Danger}"
                                Click="DeleteButton_Click"/>
                    </WrapPanel>

                    <Border Grid.Row="1" Grid.Column="2" Margin="0,10,0,0" CornerRadius="8"
                            BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FCFCFD">
                        <TextBox x:Name="MessageView" BorderThickness="0" Background="Transparent"
                                 Padding="10" FontSize="13.5" FontFamily="Consolas, Segoe UI"
                                 IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"/>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
