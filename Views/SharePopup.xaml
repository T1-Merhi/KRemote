<Window x:Class="KRemote.Views.SharePopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Share" Height="640" Width="560" MinHeight="560" MinWidth="480"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}"
        FontFamily="Segoe UI" Foreground="{StaticResource Ink}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Share" Style="{StaticResource Title}"/>

        <!-- Device picker -->
        <Border Grid.Row="1" Background="{StaticResource Card}" CornerRadius="10" Margin="0,10,0,0"
                BorderBrush="{StaticResource Line}" BorderThickness="1" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" x:Name="TargetLabel" Style="{StaticResource Subtle}"
                               VerticalAlignment="Center" Text="No device selected."/>
                    <Button Grid.Column="1" x:Name="ScanButton" Style="{StaticResource GhostButton}"
                            Content="Scan network" Click="ScanButton_Click"/>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,8,0,0">
                    <ProgressBar x:Name="ScanProgress" Height="4" Minimum="0" Maximum="100"
                                 Visibility="Collapsed" Foreground="{StaticResource Accent}"
                                 Background="#EDEFF2" BorderThickness="0"/>
                    <TextBlock x:Name="ScanStatus" Style="{StaticResource Subtle}" Margin="0,6,0,0"
                               Text="No scan yet."/>
                </StackPanel>

                <ListBox x:Name="PeerList" Grid.Row="2" Style="{StaticResource FlatList}" Height="110"
                         Margin="0,8,0,0" SelectionChanged="PeerList_SelectionChanged">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock Text="{Binding MachineName}" FontSize="13" FontWeight="SemiBold"
                                           Foreground="{StaticResource Ink}" TextTrimming="CharacterEllipsis"/>
                                <TextBlock Text="{Binding Address}" FontSize="11"
                                           Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Title -->
        <Border Grid.Row="2" Margin="0,10,0,0" CornerRadius="8"
                BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FCFCFD">
            <Grid>
                <TextBox x:Name="TitleBox" BorderThickness="0" Background="Transparent"
                         Padding="10,8" FontSize="13" MaxLength="120"
                         TextChanged="TitleBox_TextChanged"/>
                <TextBlock x:Name="TitlePlaceholder" Text="Title (optional)"
                           IsHitTestVisible="False" Margin="11,0,0,0"
                           VerticalAlignment="Center" FontSize="13"
                           Foreground="{StaticResource Muted}"/>
            </Grid>
        </Border>

        <!-- Text -->
        <Border Grid.Row="3" Margin="0,10,0,0" CornerRadius="8" Height="120"
                BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FCFCFD">
            <TextBox x:Name="Editor" BorderThickness="0" Background="Transparent"
                     Padding="10" FontSize="13.5" FontFamily="Consolas, Segoe UI"
                     AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" SpellCheck.IsEnabled="False"/>
        </Border>

        <!-- Attachments -->
        <Border Grid.Row="4" Margin="0,10,0,0" CornerRadius="8" MinHeight="60"
                BorderBrush="{StaticResource Line}" BorderThickness="1" Background="#FCFCFD" Padding="8">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="AttachmentList">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource AccentSoft}" CornerRadius="14"
                                    Margin="0,0,6,6" Padding="10,5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="{Binding FileName}" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource Ink}" MaxWidth="220" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding SizeText}" FontSize="11" Margin="6,0,0,0"
                                               VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                                    <Button Content="✕" FontSize="10" Margin="8,0,0,0" Padding="2"
                                            Background="Transparent" BorderThickness="0" Cursor="Hand"
                                            Foreground="{StaticResource Muted}"
                                            Click="RemoveAttachment_Click" Tag="{Binding}"/>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <!-- Inline error banner -->
        <Border x:Name="ErrorBanner" Grid.Row="5" Margin="0,10,0,0" CornerRadius="8"
                Background="#FDECEA" BorderBrush="{StaticResource Danger}" BorderThickness="1"
                Padding="10,8" Visibility="Collapsed">
            <TextBlock x:Name="ErrorBannerText" Foreground="{StaticResource Danger}" FontSize="12.5" TextWrapping="Wrap"/>
        </Border>

        <!-- Transfer progress -->
        <StackPanel x:Name="TransferPanel" Grid.Row="6" Margin="0,10,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="TransferProgress" Height="4" Minimum="0" Maximum="100"
                         Foreground="{StaticResource Accent}" Background="#EDEFF2" BorderThickness="0"/>
            <TextBlock x:Name="TransferStatus" Style="{StaticResource Subtle}" Margin="0,6,0,0"/>
        </StackPanel>

        <!-- Attach files -->
        <Button Grid.Row="7" x:Name="AttachFilesButton" Style="{StaticResource GhostButton}"
                Content="Attach files…" HorizontalAlignment="Left" Margin="0,10,0,0"
                Click="AttachFilesButton_Click"/>

        <!-- Send / Cancel -->
        <StackPanel Grid.Row="8" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="CancelButton" Style="{StaticResource GhostButton}" Content="Cancel"
                    Click="CancelButton_Click"/>
            <Button x:Name="SendButton" Style="{StaticResource PrimaryButton}" Content="Send"
                    Margin="8,0,0,0" MinWidth="110" Click="SendButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
