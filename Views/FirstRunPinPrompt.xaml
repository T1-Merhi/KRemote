<Window x:Class="KRemote.Views.FirstRunPinPrompt"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Protect your PC?" SizeToContent="Height" Width="440"
        WindowStartupLocation="CenterScreen" ResizeMode="NoResize"
        Background="{StaticResource Bg}" FontFamily="Segoe UI" Foreground="{StaticResource Ink}">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Protect your PC?" Style="{StaticResource Title}"/>
        <TextBlock Grid.Row="1" Style="{StaticResource Subtle}" Margin="0,8,0,0" TextWrapping="Wrap"
                   Text="Anyone who can reach this PC on the network can currently send it text and files. You can require a PIN before anyone can share with you. This can be changed later in Settings."/>

        <CheckBox x:Name="EnableCheck" Grid.Row="2" Content="Set a PIN code"
                  Margin="0,16,0,0" Checked="EnableCheck_Changed" Unchecked="EnableCheck_Changed"/>

        <StackPanel x:Name="OptionsPanel" Grid.Row="3" Margin="0,14,0,0" Visibility="Collapsed">
            <TextBlock Text="Choose a 4-digit PIN" Style="{StaticResource Subtle}" Margin="0,0,0,4"/>
            <Border CornerRadius="8" BorderBrush="{StaticResource Line}" BorderThickness="1"
                    Background="#FCFCFD" HorizontalAlignment="Left" Width="120">
                <TextBox x:Name="PinBox" BorderThickness="0" Background="Transparent"
                         Padding="10,8" FontSize="15" FontFamily="Consolas" MaxLength="4"/>
            </Border>
        </StackPanel>

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button x:Name="ContinueButton" Style="{StaticResource PrimaryButton}" Content="Continue"
                    MinWidth="110" IsDefault="True" Click="ContinueButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
