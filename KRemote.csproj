<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>KRemote</AssemblyName>
    <RootNamespace>KRemote</RootNamespace>
    <ApplicationIcon>KRemote.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup>
    <Version>1.1.0</Version>
    <Product>KRemote</Product>
    <Company>Hussein Merhi</Company>
    <Description>Send text between PCs on the same local network.</Description>
    <Copyright>Copyright (c) 2026 Hussein Merhi</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Notifications" Version="7.1.3" />
  </ItemGroup>

</Project>
